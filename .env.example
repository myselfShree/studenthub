# ==========================================
# Student Hub — Environment Configuration
# ==========================================

# Application
APP_NAME="Student Hub"
APP_ENV=development
DEBUG=True
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-key-in-production

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=studenthub_db
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/studenthub_db

# Security & JWT
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ALGORITHM=HS256

# Google Gemini AI API
GEMINI_API_KEY=your_gemini_api_key_here

# File Storage
UPLOAD_DIR=storage/uploads
MAX_FILE_SIZE_MB=50

# Frontend URL (CORS)
FRONTEND_URL=http://localhost:3000
